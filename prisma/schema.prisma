generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model workspace {
  groupId              Int                        @id @unique
  groupName            String? @db.Text
  groupLogo            String? @db.Text
  lastSynced           DateTime?
  lastSyncedSuccessful Boolean?                   @default(false)
  customName           String? @db.Text
  memberCount          Int?
  isVerified           Boolean?                   @default(false)
  adjustments          ActivityAdjustment[]
  activityHistory      ActivityHistory[]
  activityResets       ActivityReset[]
  activitySessions     ActivitySession[]
  allies               Ally[]
  quotas               Quota[]
  sessionTypes         SessionType[]
  apiKey               apiKey[]
  config               config[]
  savedViews           SavedView[]
  documents            document[]
  documentFolders      documentFolder[]
  inactivityNotices    inactivityNotice[]
  ranks                rank[]
  roles                role[]
  departments          department[]
  userBook             userBook[]
  wallposts            wallPost[]
  externalServices     workspaceExternalServices?
  members              workspaceMember[]
  policyLinks          PolicyShareableLink[]
  stickyAnnouncements  StickyAnnouncement[]
  staffResignations    staffResignation[]
}

model config {
  id               Int       @id @default(autoincrement())
  key              String @db.Text
  value            Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspaceGroupId Int
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model instanceConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model user {
  userid                   BigInt                  @id @unique
  isOwner                  Boolean?
  picture                  String? @db.Text
  username                 String? @db.Text
  registered               Boolean?
  isFirstLogin             Boolean?                @default(true)
  birthdayDay              Int?
  birthdayMonth            Int?
  discordUser              DiscordUser?
  googleUser               GoogleUser?
  authSessions             AuthSession[]
  adjustmentsMade          ActivityAdjustment[]    @relation("AdjustmentActor")
  adjustmentsReceived      ActivityAdjustment[]    @relation("AdjustmentUser")
  activityHistory          ActivityHistory[]
  activityResets           ActivityReset[]
  activitySessions         ActivitySession[]
  sessions                 Session[]
  sessionLogsAsActor       SessionLog[]            @relation("SessionLogActor")
  sessionLogsAsTarget      SessionLog[]            @relation("SessionLogTarget")
  sessionNotes             SessionNote[]
  allyVisits               allyVisit[]
  apiKey                   apiKey[]
  documents                document[]
  inactivityNotices        inactivityNotice[]
  ranks                    rank[]
  sessionsRoles            sessionUser[]
  writtenBooks             userBook[]              @relation("bookAdmin")
  book                     userBook[]              @relation("bookUser")
  info                     userInfo?
  wallPosts                wallPost[]
  workspaceMemberships     workspaceMember[]
  managedMembers           workspaceMember[]       @relation("LineManager")
  Ally                     Ally[]                  @relation("AllyTouser")
  roles                    role[]                  @relation("roleTouser")
  roleMembers              RoleMember[]
  policyAcknowledgments    PolicyAcknowledgment[]
  createdPolicyLinks       PolicyShareableLink[]
  staffResignations        staffResignation[]
  resignationsReviewed     staffResignation[]      @relation("ResignationReviewer")
  quotaCustomCompletions   QuotaCustomCompletion[] @relation("QuotaCompletionUser")
  quotaCompletionsReviewed QuotaCustomCompletion[] @relation("QuotaCompletionReviewer")
  quotaUsers               QuotaUser[]
}

model AuthSession {
  id        String   @id @unique @default(uuid()) @db.Char(36)
  userId    BigInt
  token     String   @unique
  ipAddress String? @db.Text
  userAgent String? @db.Text
  browser   String? @db.Text
  os        String? @db.Text
  device    String? @db.Text
  region    String? @db.Text
  country   String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  user      user     @relation(fields: [userId], references: [userid])
}

model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    BigInt?
  provider  String   @default("roblox")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([state])
  @@index([expiresAt])
}

model ValidationState {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    BigInt
  createdAt DateTime @default(now())

  @@index([code])
}

model VerificationState {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    BigInt
  isReset   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([code])
}

model pendingVerification {
  token            String   @id @unique @default(uuid()) @db.Char(36)
  userid           Int
  verificationCode String @db.Text
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([expiresAt])
}

model DiscordUser {
  discordUserId BigInt   @id
  robloxUserId  BigInt?  @unique
  username      String @db.Text
  avatar        String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          user?    @relation(fields: [robloxUserId], references: [userid])
}

model GoogleUser {
  googleUserId String   @id
  robloxUserId BigInt?  @unique
  username     String @db.Text
  avatar       String? @db.Text
  email        String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         user?    @relation(fields: [robloxUserId], references: [userid])
}

model userInfo {
  userid       BigInt  @id
  passwordhash String? @db.Text
  tfa          String? @db.Text
  user         user    @relation(fields: [userid], references: [userid])
}

model QuotaRole {
  quotaId String @db.Char(36)
  roleId  String @db.Char(36)
  quota   Quota  @relation(fields: [quotaId], references: [id])
  role    role   @relation(fields: [roleId], references: [id])

  @@unique([quotaId, roleId])
}

model role {
  id               String        @id @unique @default(uuid()) @db.Char(36)
  permissions      Json @default("[]")
  isOwnerRole      Boolean?      @default(false)
  workspaceGroupId Int
  name             String @db.Text
  groupRoles       Json @default("[]")
  position         Int           @default(0)
  color            String? @db.Text
  quotaRoles       QuotaRole[]
  workspace        workspace     @relation(fields: [workspaceGroupId], references: [groupId])
  SessionType      SessionType[] @relation("SessionTypeTorole")
  documents        document[]    @relation("documentTorole")
  members          user[]        @relation("roleTouser")
  roleMembers      RoleMember[]
}

model RoleMember {
  roleId        String   @db.Char(36)
  userId        BigInt
  manuallyAdded Boolean  @default(false)
  createdAt     DateTime @default(now())
  role          role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user          user     @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@id([roleId, userId])
}

model department {
  id                String             @id @unique @default(uuid()) @db.Char(36)
  name              String @db.Text
  color             String? @db.Text
  workspaceGroupId  Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         workspace          @relation(fields: [workspaceGroupId], references: [groupId])
  departmentMembers DepartmentMember[]
  quotaDepartments  QuotaDepartment[]
  SessionType       SessionType[]      @relation("SessionTypeTodepartment")
  documents         document[]         @relation("documentTodepartment")
}

model DepartmentMember {
  departmentId     String          @db.Char(36)
  workspaceGroupId Int
  userId           BigInt
  department       department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  workspaceMember  workspaceMember @relation(fields: [workspaceGroupId, userId], references: [workspaceGroupId, userId], onDelete: Cascade)

  @@id([departmentId, workspaceGroupId, userId])
}

model QuotaDepartment {
  quotaId      String     @db.Char(36)
  departmentId String     @db.Char(36)
  quota        Quota      @relation(fields: [quotaId], references: [id])
  department   department @relation(fields: [departmentId], references: [id])

  @@unique([quotaId, departmentId])
}

model QuotaUser {
  quotaId String @db.Char(36)
  userId  BigInt
  quota   Quota  @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  user    user   @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([quotaId, userId])
}

model wallPost {
  id               Int       @id @default(autoincrement())
  content          String @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspaceGroupId Int
  authorId         BigInt
  image            String? @db.Text
  author           user      @relation(fields: [authorId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model StickyAnnouncement {
  id               Int       @id @default(autoincrement())
  workspaceGroupId Int
  title            String @db.Text
  subtitle         String? @db.Text
  sections         Json // Array of {title: string, content: string}
  editorId         BigInt?
  editorUsername   String? @db.Text
  editorPicture    String? @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@unique([workspaceGroupId])
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  workspaceGroupId Int
  userId           BigInt?
  action           String
  entity           String?
  details          Json?
  createdAt        DateTime @default(now())

  @@index([workspaceGroupId, createdAt(sort: Desc)])
  @@index([workspaceGroupId, action, createdAt(sort: Desc)])
  @@index([workspaceGroupId, userId, createdAt(sort: Desc)])
  @@index([workspaceGroupId, entity, createdAt(sort: Desc)])
}

model SessionType {
  id                 String       @id @unique @default(uuid()) @db.Char(36)
  name               String @db.Text
  gameId             BigInt?
  allowUnscheduled   Boolean
  workspaceGroupId   Int
  statues            Json @default("[]")
  slots              Json @default("[]")
  description        String? @db.Text
  sessions           Session[]
  workspace          workspace    @relation(fields: [workspaceGroupId], references: [groupId])
  schedule           schedule[]
  hostingRoles       role[]       @relation("SessionTypeTorole")
  hostingDepartments department[] @relation("SessionTypeTodepartment")
}

model schedule {
  id            String      @id @unique @default(uuid()) @db.Char(36)
  Days          Json @default("[]")
  Hour          Int
  Minute        Int
  sessionTypeId String      @db.Char(36)
  sessions      Session[]
  sessionType   SessionType @relation(fields: [sessionTypeId], references: [id])
}

model sessionUser {
  userid           BigInt
  sessionid        String    @db.Char(36)
  roleID           String
  slot             Int
  archived         Boolean?  @default(false)
  archiveStartDate DateTime?
  archiveEndDate   DateTime?
  session          Session   @relation(fields: [sessionid], references: [id])
  user             user      @relation(fields: [userid], references: [userid])

  @@id([userid, sessionid, roleID, slot])
}

model Session {
  id                 String        @id @unique @default(uuid()) @db.Char(36)
  ownerId            BigInt?
  date               DateTime
  startedAt          DateTime?
  ended              DateTime?
  duration           Int           @default(30) // Duration in minutes
  sessionTypeId      String        @db.Char(36)
  scheduleId         String?       @db.Char(36)
  name               String? @db.Text
  type               String? @db.Text
  archived           Boolean?      @default(false)
  archiveStartDate   DateTime?
  archiveEndDate     DateTime?
  cancelled          Boolean?      @default(false)
  cancellationReason String? @db.Text
  owner              user?         @relation(fields: [ownerId], references: [userid])
  schedule           schedule?     @relation(fields: [scheduleId], references: [id])
  sessionType        SessionType   @relation(fields: [sessionTypeId], references: [id])
  logs               SessionLog[]
  notes              SessionNote[]
  users              sessionUser[]
}

model SessionNote {
  id        String   @id @unique @default(uuid()) @db.Char(36)
  sessionId String   @db.Char(36)
  authorId  BigInt
  content   String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    user     @relation(fields: [authorId], references: [userid])
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionLog {
  id        String   @id @unique @default(uuid()) @db.Char(36)
  sessionId String   @db.Char(36)
  actorId   BigInt
  targetId  BigInt?
  action    String @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  actor     user     @relation("SessionLogActor", fields: [actorId], references: [userid])
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  target    user?    @relation("SessionLogTarget", fields: [targetId], references: [userid])
}

model ActivitySession {
  id               String    @id @unique @default(uuid()) @db.Char(36)
  userId           BigInt
  active           Boolean
  startTime        DateTime
  endTime          DateTime?
  idleTime         BigInt?
  workspaceGroupId Int
  messages         Int?
  chatLog          Json?
  universeId       BigInt?
  sessionMessage   String? @db.Text
  archived         Boolean?  @default(false)
  archiveStartDate DateTime?
  archiveEndDate   DateTime?
  user             user      @relation(fields: [userId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model apiKey {
  id               String    @id @unique
  name             String @db.Text
  key              String    @unique
  lastUsed         DateTime?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  workspaceGroupId Int
  createdById      BigInt
  createdBy        user      @relation(fields: [createdById], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model inactivityNotice {
  id               String    @id @unique @default(uuid()) @db.Char(36)
  userId           BigInt
  startTime        DateTime
  endTime          DateTime?
  reason           String @db.Text
  approved         Boolean?  @default(false)
  reviewed         Boolean?  @default(false)
  workspaceGroupId Int
  revoked          Boolean?  @default(false)
  reviewComment    String? @db.Text
  user             user      @relation(fields: [userId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model staffResignation {
  id               String    @id @unique @default(uuid()) @db.Char(36)
  userId           BigInt
  workspaceGroupId Int
  lastWorkingDay   DateTime
  reason           String @db.Text
  approved         Boolean?  @default(false)
  reviewed         Boolean?  @default(false)
  reviewComment    String? @db.Text
  reviewerId       BigInt?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             user      @relation(fields: [userId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])
  reviewer         user?     @relation("ResignationReviewer", fields: [reviewerId], references: [userid])

  @@index([workspaceGroupId])
  @@index([userId])
}

model document {
  id                     String                 @id @unique @default(uuid()) @db.Char(36)
  name                   String @db.Text
  content                Json
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  ownerId                BigInt
  workspaceGroupId       Int
  folderId               String?                @db.Char(36)
  requiresAcknowledgment Boolean                @default(false)
  acknowledgmentDeadline DateTime?
  acknowledgmentMethod   String?                @default("signature")
  acknowledgmentWord     String? @db.Text
  assignToEveryone       Boolean                @default(false)
  isTrainingDocument     Boolean                @default(false)
  owner                  user                   @relation(fields: [ownerId], references: [userid])
  workspace              workspace              @relation(fields: [workspaceGroupId], references: [groupId])
  folder                 documentFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  roles                  role[]                 @relation("documentTorole")
  departments            department[]           @relation("documentTodepartment")
  acknowledgments        PolicyAcknowledgment[]
  shareableLinks         PolicyShareableLink[]

  @@index([folderId])
}

model documentFolder {
  id               String           @id @unique @default(uuid()) @db.Char(36)
  name             String @db.Text
  icon             String           @default("folder")
  workspaceGroupId Int
  parentId         String?          @db.Char(36)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        workspace        @relation(fields: [workspaceGroupId], references: [groupId], onDelete: Cascade)
  parent           documentFolder?  @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         documentFolder[] @relation("DocumentFolderTree")
  documents        document[]

  @@index([workspaceGroupId])
  @@index([parentId])
}

model userBook {
  id               String    @id @unique @default(uuid()) @db.Char(36)
  userId           BigInt
  type             String @db.Text
  reason           String @db.Text
  adminId          BigInt
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  redacted         Boolean?  @default(false)
  redactedBy       BigInt?
  redactedAt       DateTime?
  workspaceGroupId Int
  rankBefore       Int?
  rankAfter        Int?
  rankNameBefore   String? @db.Text
  rankNameAfter    String? @db.Text
  admin            user      @relation("bookAdmin", fields: [adminId], references: [userid])
  user             user      @relation("bookUser", fields: [userId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model rank {
  userId           BigInt
  rankId           BigInt
  workspaceGroupId Int
  user             user      @relation(fields: [userId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@id([userId, workspaceGroupId])
}

model Quota {
  id                String                  @id @default(uuid()) @db.Char(36)
  type              String @db.Text
  value             Int?
  workspaceGroupId  Int
  name              String @db.Text
  description       String? @db.Text
  sessionType       String? @db.Text
  workspace         workspace               @relation(fields: [workspaceGroupId], references: [groupId])
  quotaRoles        QuotaRole[]
  quotaDepartments  QuotaDepartment[]
  quotaUsers        QuotaUser[]
  customCompletions QuotaCustomCompletion[]
}

model QuotaCustomCompletion {
  id               String    @id @default(uuid()) @db.Char(36)
  quotaId          String    @db.Char(36)
  userId           BigInt
  status           String
  submittedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId BigInt?
  quota            Quota     @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  user             user      @relation("QuotaCompletionUser", fields: [userId], references: [userid], onDelete: Cascade)
  reviewedBy       user?     @relation("QuotaCompletionReviewer", fields: [reviewedByUserId], references: [userid], onDelete: SetNull)

  @@unique([quotaId, userId])
  @@index([quotaId, status])
}

model Ally {
  workspaceGroupId         Int
  name                     String @db.Text
  icon                     String @db.Text
  groupId                  String @db.Text
  notes                    Json @default("[]")
  discordServer            String? @db.Text
  theirReps                Json @default("[]")
  strikes                  Int         @default(0)
  terminationEffectiveDate DateTime?
  terminationReason        String? @db.Text
  id                       String      @id @unique @default(uuid()) @db.Char(36)
  workspace                workspace   @relation(fields: [workspaceGroupId], references: [groupId])
  allyVisits               allyVisit[]
  reps                     user[]      @relation("AllyTouser")
}

model allyVisit {
  id           String   @id @unique @default(uuid()) @db.Char(36)
  allyId       String   @db.Char(36)
  hostId       BigInt
  time         DateTime
  name         String @db.Text
  participants Json @default("[]")
  ally         Ally     @relation(fields: [allyId], references: [id])
  host         user     @relation(fields: [hostId], references: [userid])
}

model workspaceMember {
  workspaceGroupId  Int
  userId            BigInt
  joinDate          DateTime?
  birthdayDay       Int?
  birthdayMonth     Int?
  lineManagerId     BigInt?
  timezone          String? @db.Text
  discordId         String? @db.Text
  isAdmin           Boolean?           @default(false)
  introNote         String? @db.Text
  introSong         String? @db.Text
  user              user               @relation(fields: [userId], references: [userid])
  workspace         workspace          @relation(fields: [workspaceGroupId], references: [groupId])
  lineManager       user?              @relation("LineManager", fields: [lineManagerId], references: [userid], onDelete: NoAction, onUpdate: NoAction)
  departmentMembers DepartmentMember[]

  @@id([workspaceGroupId, userId])
  @@index([userId])
  @@index([lineManagerId])
}

model ActivityAdjustment {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           BigInt
  actorId          BigInt
  workspaceGroupId Int
  minutes          Int
  reason           String? @db.Text
  createdAt        DateTime  @default(now())
  archived         Boolean?  @default(false)
  archiveStartDate DateTime?
  archiveEndDate   DateTime?
  actor            user      @relation("AdjustmentActor", fields: [actorId], references: [userid])
  user             user      @relation("AdjustmentUser", fields: [userId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([userId])
  @@index([actorId])
  @@index([workspaceGroupId])
}

model ActivityHistory {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           BigInt
  workspaceGroupId Int
  periodStart      DateTime
  periodEnd        DateTime
  minutes          Int
  messages         Int
  sessionsHosted   Int
  sessionsAttended Int
  idleTime         Int
  wallPosts        Int       @default(0)
  quotaProgress    Json
  createdAt        DateTime  @default(now())
  user             user      @relation(fields: [userId], references: [userid])
  workspace        workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([userId])
  @@index([workspaceGroupId])
  @@index([periodStart])
  @@index([periodEnd])
}

model ActivityReset {
  id                  String    @id @default(uuid()) @db.Char(36)
  workspaceGroupId    Int
  resetById           BigInt?
  resetAt             DateTime  @default(now())
  previousPeriodStart DateTime?
  previousPeriodEnd   DateTime?
  resetBy             user?     @relation(fields: [resetById], references: [userid])
  workspace           workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId])
  @@index([resetAt])
}

model workspaceExternalServices {
  id                 Int       @id @default(autoincrement())
  workspaceGroupId   Int       @unique
  rankingProvider    String? @db.Text
  rankingToken       String? @db.Text
  rankingWorkspaceId String? @db.Text
  rankingMaxRank     Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId])
}

model SavedView {
  id               String   @id @default(uuid()) @db.Char(36)
  workspaceGroupId Int
  name             String @db.Text
  color            String? @db.Text
  icon             String? @db.Text
  filters          Json
  columnVisibility Json
  createdAt        DateTime @default(now())

  workspace workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId])
}

model PolicyAcknowledgment {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         BigInt
  documentId     String   @db.Char(36)
  acknowledgedAt DateTime @default(now())
  ipAddress      String? @db.Text
  signature      String? @db.Text // Digital signature or acknowledgment text
  isRequired     Boolean  @default(false)
  user           user     @relation(fields: [userId], references: [userid])
  document       document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
}

model PolicyShareableLink {
  id               String    @id @default(uuid()) @db.Char(36)
  documentId       String    @db.Char(36)
  workspaceGroupId Int
  name             String @db.Text // User-defined name for the link
  description      String? @db.Text // Optional description
  createdById      BigInt
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  accessCount      Int       @default(0)
  lastAccessed     DateTime?

  document  document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace workspace @relation(fields: [workspaceGroupId], references: [groupId])
  createdBy user      @relation(fields: [createdById], references: [userid])

  @@index([documentId])
  @@index([workspaceGroupId])
  @@index([createdById])
}
