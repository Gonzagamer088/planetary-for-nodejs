############
# Orbit (Planetary) - environment variables (MySQL version)
# Copy this file to ".env" and fill it in. Everything else is done automatically on startup.
############

# External MySQL from your host (IP or domain of the MySQL server)
DATABASE_URL=mysql://USER:PASSWORD@MYSQL_IP:3306/DATABASE_NAME

# Public URL of your panel, without a trailing "/"
NEXTAUTH_URL=https://your-domain.com

# Roblox group ID: if the user has access to the workspace, they are redirected to it
ROBLOX_WORKSPACE_REDIRECTID=12345566

# Optional
# SESSION_SECRET=         (if left empty it is generated automatically and saved in .session-secret)
# PORT=3000               (the panel usually sets it)
# DB_POOL_SIZE=10
# ORBIT_MAX_MEMORY=2500   (maximum MB of RAM for Node)
